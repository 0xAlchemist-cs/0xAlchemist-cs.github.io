digraph DevFlow {
  graph [
    rankdir=TB,
    splines=polyline,
    nodesep=0.55,
    ranksep=0.61,
    pad=0.5,
    bgcolor="#F8FAFD",
    fontname="Noto Sans CJK SC",
    label="免费技术博客  |  开发、上线与持续发布流程\n可交给 Codex 分阶段执行 · 每阶段验证 · CI 失败不发布",
    labelloc=t,
    labeljust=l,
    fontsize=23,
    fontcolor="#142D4E"
  ];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=13, color="#C5D8EA", fillcolor="white", fontcolor="#1D3757", penwidth=1.3, margin="0.25,0.17"];
  edge [color="#7B98B7", penwidth=1.65, arrowsize=.75, fontname="Noto Sans CJK SC", fontsize=10, fontcolor="#466488"];

  subgraph cluster_init {
    label="A  首次建设 / 初始化";
    color="#D1E2F5"; fillcolor="#EEF6FD"; style="rounded,filled";
    fontname="Noto Sans CJK SC"; fontcolor="#2463A0"; fontsize=15;
    start [label="确定 GitHub 用户名与站点配置\n公开仓库 <username>.github.io", fillcolor="#DCECFD", color="#A5C9EA"];
    scaffold [label="Astro + TypeScript 初始化\n无服务器、无数据库、无付费 Key"];
    pages [label="文章模型与博客页面\n分类 · 项目 · About · RSS"];
    seo [label="SEO / GEO 基础\nMetadata · JSON-LD · Sitemap · robots"];
    github [label="GitHub 公开项目联动\n精选清单 · API 缓存 · 降级"];
  }

  subgraph cluster_review {
    label="B  开发质量门禁";
    color="#CBE6DC"; fillcolor="#EFFAF5"; style="rounded,filled";
    fontname="Noto Sans CJK SC"; fontcolor="#287B63"; fontsize=15;
    pr [label="提交代码 / 内容到 PR\n执行 TypeScript、SEO 审计、链接与构建"];
    passed [shape=diamond, label="CI 全部通过？", fillcolor="#E0F6E9", color="#94CFB2", margin="0.15,0.08"];
    fix [label="修复错误并复测\n不跳过 CI、不强制部署", fillcolor="#FFF0E4", color="#EAC1A2"];
    merge [label="人工审查后合并 main", fillcolor="#DCF3E8"];
  }

  subgraph cluster_publish {
    label="C  免费部署与上线验收";
    color="#DCCDF1"; fillcolor="#F7F1FE"; style="rounded,filled";
    fontname="Noto Sans CJK SC"; fontcolor="#7451A0"; fontsize=15;
    deploy [label="GitHub Actions 构建 & 部署\nGitHub Pages · HTTPS", fillcolor="#E9DEFB", color="#C9B4EA"];
    online [shape=diamond, label="站点与关键 URL 正常？\n首页 · 文章 · Sitemap · RSS", fillcolor="#F2E9FD", color="#BBA2E2"];
    debug [label="查看 Actions / 路径配置\n修复后重新构建", fillcolor="#FFF0E4", color="#EAC1A2"];
    success [label="上线：<username>.github.io\n无需域名 / 服务器费用", fillcolor="#DCF3E8", color="#8EC8AC", penwidth=1.8];
  }

  subgraph cluster_operate {
    label="D  内容运营 / 持续迭代";
    color="#E7DABB"; fillcolor="#FFF9EE"; style="rounded,filled";
    fontname="Noto Sans CJK SC"; fontcolor="#987131"; fontsize=15;
    author [label="日常撰写 Markdown 文章\n增加项目链接与可信来源"];
    monitor [label="可选：Google Search Console\n检查索引、曝光、页面体验"];
    feedback [label="根据证据改进文章与体验\n再次 PR → CI → 自动发布", fillcolor="#FFF0D6", color="#ECCF90"];
  }

  start -> scaffold -> pages -> seo -> github -> pr -> passed;
  passed -> fix [label="否", color="#C99F80"];
  fix -> pr [constraint=false, style=dashed, color="#C99F80"];
  passed -> merge [label="是"];
  merge -> deploy -> online;
  online -> debug [label="否", color="#C99F80"];
  debug -> pr [constraint=false, style=dashed, color="#C99F80"];
  online -> success [label="是"];
  success -> author [label="日常更新"];
  success -> monitor [style=dashed, label="可选注册"];
  author -> feedback [label="内容改进"];
  monitor -> feedback [style=dashed, label="真实数据"];
  feedback -> pr [constraint=false, style=dashed, color="#C0A06C"];
}
