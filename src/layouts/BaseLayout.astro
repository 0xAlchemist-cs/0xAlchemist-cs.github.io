---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import { site, absolute } from '../config/site';
import type { SocialImage } from '../lib/social-card';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  socialImage?: SocialImage;
  wide?: boolean;
}
const { schemas = [], wide = false, ...seo } = Astro.props;
const globalSchemas = [
  {
    '@type': 'WebSite',
    name: site.title,
    url: absolute('/'),
    inLanguage: site.language,
  },
  {
    '@type': 'Person',
    '@id': absolute('/about/#author'),
    name: site.author,
    url: absolute('/about/'),
    sameAs: [site.github],
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SeoHead {...seo} schemas={[...globalSchemas, ...schemas]} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <ParticleBackground />
    <div class="site-shell">
      {import.meta.env.DEV && (
        <div class="preview-notice">
          本地开发预览 · 包含明确标注的示例与草稿，正式构建会排除这些内容。
        </div>
      )}
      <Header />
      <main id="main" class:list={[{ 'wide-content': wide }]} tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <a class="footer-name" href="/">
            0xAlchemist
          </a>
          <span>记录，让想法慢慢成形。</span>
        </div>
        <div class="footer-links">
          <a href="/archive/">归档</a>
          <a href="/rss.xml">RSS ↗</a>
          <a href={site.github}>GitHub ↗</a>
          <button id="motion-toggle" type="button" aria-pressed="true">
            背景动态
          </button>
        </div>
        <p>
          © {new Date().getUTCFullYear()} {site.author} · Built with Astro
        </p>
      </footer>
    </div>
  </body>
</html>
