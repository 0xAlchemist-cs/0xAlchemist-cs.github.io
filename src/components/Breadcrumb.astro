---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑">
  <a href="/">首页</a>
  {items.map((item) => (
    <Fragment>
      <span aria-hidden="true">/</span>
      {item.href ? (
        <a href={item.href}>{item.label}</a>
      ) : (
        <span aria-current="page">{item.label}</span>
      )}
    </Fragment>
  ))}
</nav>
